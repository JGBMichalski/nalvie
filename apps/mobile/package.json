  "version": "0.0.0",
  "main": "expo-router/entry",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@nalvie/core": "workspace:*",
    "@react-native-community/slider": "5.2.0",
    "expo": "~57.0.14",
